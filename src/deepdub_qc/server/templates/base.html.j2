{# App shell (gui-design-spec section 3). Brand tokens resolved against the
   Deepdub brand package; typefaces are self-hosted from /static/fonts/ so the
   console renders correctly on air-gapped broadcast networks. #}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Deepdub QC{% endblock %}</title>
{# Preload the two faces actually used above the fold; both are variable-weight
   so no per-weight requests are needed. crossorigin is required on preload for
   fonts even same-origin, or the fetch is made twice. #}
<link rel="preload" href="/static/fonts/onest-latin-wght-normal.woff2"
      as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/fonts/jetbrains-mono-latin-wght-normal.woff2"
      as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/app.css">
</head>
<body>
<header class="shell-header">
  <div class="shell-header-inner">
    <a class="wordmark" href="/" aria-label="Deepdub QC — home"
      ><img src="/static/wordmark.svg" alt="Deepdub" width="106" height="24"
      ><span class="qc-tag" aria-hidden="true">QC</span></a>
    {# One macro for all three items so the active-state markup exists in exactly
       one place. aria-current is what conveys the current page to assistive tech;
       the .active class only drives the magenta underline, and the font-weight
       shift in app.css means the state is not signalled by colour alone. #}
    {%- macro nav_link(href, key, label) -%}
      {%- set is_active = (nav == key) -%}
      <a href="{{ href }}"{% if is_active %} class="active" aria-current="page"{% endif %}>{{ label }}</a>
    {%- endmacro -%}
    <nav aria-label="Main">
      {{ nav_link('/', 'submit', 'Submit') }}
      {{ nav_link('/jobs', 'jobs', 'Jobs') }}
      {{ nav_link('/presets', 'presets', 'Presets') }}
      {{ nav_link('/watch', 'watch', 'Watch folders') }}
    </nav>
    {# The dot itself is a ::before pseudo-element so the status has a real text
       label; app.js swaps .down and rewrites the label text. #}
    <span class="health" id="health-dot" role="status" aria-live="polite"
          title="QC service health"><span>Service up</span></span>
  </div>
</header>
<main>{% block content %}{% endblock %}</main>
<footer class="shell-footer mono">deepdub-qc v{{ version }} · Phase 3.5 console</footer>
<script src="/static/app.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>

{% macro verdict_badge(status, size='sm') %}
{%- set icons = {'PASS': '✓', 'WARNING': '⚠', 'FAIL': '✕', 'ERROR': '◆'} -%}
{%- if status -%}
<span class="badge badge-{{ status|lower }} badge-{{ size }}"
  {%- if status == 'ERROR' %} title="The pipeline could not finish — this is not a media verdict. Check the job log."{% endif -%}
>{{ icons.get(status, '') }} {{ status }}</span>
{%- else -%}<span class="dim">—</span>{%- endif -%}
{% endmacro %}

{% macro job_chip(status, position=None, total=None) %}
{%- if status == 'pending' -%}
<span class="chip">○ Queued{% if position %} · #{{ position }}{% endif %}</span>
{%- elif status == 'running' -%}
<span class="chip chip-running"><span class="spinner"></span> Running</span>
{%- elif status == 'completed' -%}
<span class="chip">● Done</span>
{%- elif status == 'failed' -%}
<span class="chip chip-failed">◆ Job failed</span>
{%- elif status == 'cancelled' -%}
<span class="chip">⊘ Cancelled</span>
{%- endif -%}
{% endmacro %}

{% macro preset_status_pill(status) %}
<span class="pill pill-{{ status }}">{{ status }}</span>
{% endmacro %}

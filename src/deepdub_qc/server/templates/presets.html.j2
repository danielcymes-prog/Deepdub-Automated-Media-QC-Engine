{% extends "base.html.j2" %}
{% from "base.html.j2" import preset_status_pill %}
{% set nav = 'presets' %}
{% block title %}Presets — Deepdub QC{% endblock %}
{% block content %}
<h1>Presets</h1>
<p class="dim">Presets are versioned files. <strong>Edit</strong> opens the console
editor — every save creates a new draft version with an audit trail; nothing is
changed in place, and approval still happens via <span class="mono">presets
lock</span>.</p>
{% if saved %}
<div class="banner" role="status"><span>✓</span>
  <div>Saved <span class="mono">{{ saved }}</span> as a new draft version.
       It is selectable on the Submit page now.</div>
</div>
{% endif %}
{# No `rows-linked` class: these rows do not navigate anywhere, so they must not
   claim a pointer cursor. Row hover highlight still applies for tracking across
   five columns. #}
{% set listed_entries = catalog|selectattr('listed')|list %}
{% set library_entries = catalog|rejectattr('listed')|list %}
{% macro preset_table(entries, caption) %}
<table class="data-table">
  <caption class="visually-hidden">{{ caption }}</caption>
  <thead><tr><th scope="col">Title</th><th scope="col">ID / version</th>
             <th scope="col">Content type</th><th scope="col">Status</th>
             <th scope="col">Effective</th>
             <th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  {% for client, group in entries|groupby('client') %}
    {# A group header row, not a data row — announced as a row header, and the
       colspan is derived from the header count above. #}
    <tr class="group-row"><th scope="colgroup" colspan="6">{{ client }}</th></tr>
    {% for p in group %}
    <tr>
      {# The description was previously title-only, which is unreachable by
         keyboard and invisible on touch. Rendered inline as a second line. #}
      <td>{{ p.title }}
        {% if p.description %}
        <span class="cell-caption">{{ p.description }}</span>
        {% endif %}
      </td>
      <td class="mono">{{ p.preset_id }}@{{ p.version }}</td>
      <td>{{ p.content_type }}</td>
      <td>{{ preset_status_pill(p.status) }}</td>
      <td class="mono">{{ p.effective_date }}</td>
      {# Approved presets are immutable (ADR-013): the same editor drafts their
         successor, so only the label differs. #}
      <td><a class="button" href="/presets/{{ p.preset_id }}/{{ p.version }}/edit"
            >{{ 'Edit' if p.status == 'draft' else 'New draft' }}</a></td>
    </tr>
    {% endfor %}
  {% endfor %}
  </tbody>
</table>
{% endmacro %}
{% if catalog %}
{{ preset_table(listed_entries, 'Available QC presets, grouped by client. Read-only.') }}
{% if library_entries %}
<details class="log-tail">
  <summary class="dim">Vidchecker library — reference only, not in the submit picker
    ({{ library_entries|length }} presets)</summary>
  {{ preset_table(library_entries,
                  'Imported Vidchecker reference presets. Read-only, not selectable
                   on the Submit page.') }}
</details>
{% endif %}
{% else %}
{# The jobs list had an empty state; this one did not, so an empty or unreadable
   presets_root rendered bare column headers with no explanation. #}
<div class="empty-state">
  <p>No presets found.</p>
  <p class="field-help">The configured presets directory is empty or unreadable.
     Presets are versioned files in the repository — check
     <span class="mono">paths.presets_root</span> in the server configuration.</p>
</div>
{% endif %}
{% endblock %}
